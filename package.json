{
  "name": "sniplockr",
  "version": "0.4.0",
  "description": "A code snippet manager for organizing and managing your code snippets locally in your browser. Built with React and TypeScript.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pradumnasaraf/SnipLockr.git"
  },
  "author": "Pradumnasaraf",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/Pradumnasaraf/SnipLockr/issues"
  },
  "homepage": "https://github.com/Pradumnasaraf/SnipLockr#readme",
  "keywords": [
    "code-snippets",
    "snippet-manager",
    "local-storage",
    "code-editor",
    "monaco-editor",
    "syntax-highlighting",
    "react",
    "typescript",
    "vite",
    "local-first",
    "code-organization",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.4"
  }
}
